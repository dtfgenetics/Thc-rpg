generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BattleStatus {
  ACTIVE
  WON
  LOST
}

enum BattleSide {
  PLAYER
  ENEMY
}

enum MoveKind {
  DAMAGE
  SHIELD
  DEBUFF
}

model Player {
  id          String            @id @default(cuid())
  handle      String            @unique
  kushCoin    Int               @default(0)
  reputation  Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  companions  PlayerCompanion[]
  partySlots  PartySlot[]
  battles     Battle[]
}

model CompanionTemplate {
  id             String            @id @default(cuid())
  slug           String            @unique
  name           String
  primaryType    String
  secondaryType  String?
  role           String
  baseHp         Int
  potency        Int
  vigor          Int
  speed          Int
  resin          Int
  terpenes       Int
  stability      Int
  awakeningName  String
  starter        Boolean           @default(false)
  moves          TemplateMove[]
  playerCopies   PlayerCompanion[]
}

model MoveTemplate {
  id              String         @id @default(cuid())
  slug            String         @unique
  name            String
  type            String
  kind            MoveKind
  basePower       Int
  accuracy        Int            @default(100)
  meterGain       Int            @default(10)
  timingPattern   Json
  goodBonusCap    Float          @default(0.15)
  perfectBonusCap Float          @default(0.35)
  statusEffect    String?
  awakeningOnly   Boolean        @default(false)
  cooldown        Int            @default(0)
  templates       TemplateMove[]
}

model TemplateMove {
  id                  String            @id @default(cuid())
  companionTemplateId String
  moveTemplateId      String
  levelRequired       Int               @default(1)
  companionTemplate   CompanionTemplate @relation(fields: [companionTemplateId], references: [id], onDelete: Cascade)
  moveTemplate        MoveTemplate      @relation(fields: [moveTemplateId], references: [id], onDelete: Cascade)

  @@unique([companionTemplateId, moveTemplateId])
}

model PlayerCompanion {
  id         String            @id @default(cuid())
  playerId   String
  templateId String
  nickname   String?
  level      Int               @default(1)
  xp         Int               @default(0)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  player     Player            @relation(fields: [playerId], references: [id], onDelete: Cascade)
  template   CompanionTemplate @relation(fields: [templateId], references: [id])
  partySlots PartySlot[]
}

model PartySlot {
  id          String          @id @default(cuid())
  playerId    String
  companionId String
  position    Int
  player      Player          @relation(fields: [playerId], references: [id], onDelete: Cascade)
  companion   PlayerCompanion @relation(fields: [companionId], references: [id], onDelete: Cascade)

  @@unique([playerId, position])
  @@unique([playerId, companionId])
}

model NpcTemplate {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  partyJson Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Battle {
  id          String       @id @default(cuid())
  playerId    String
  npcSlug     String
  status      BattleStatus @default(ACTIVE)
  turnNumber  Int          @default(1)
  activeSide  BattleSide   @default(PLAYER)
  state       Json
  log         Json
  rewardsJson Json?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  player      Player       @relation(fields: [playerId], references: [id], onDelete: Cascade)
}
